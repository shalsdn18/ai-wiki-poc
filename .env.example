# Copy this file to .env for local use. Never commit the real key.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
OBSIDIAN_VAULT_PATH=C:\Users\your-name\Documents\MyVault
OBSIDIAN_IMPORT_DELAY_SECONDS=5
OBSIDIAN_IMPORT_MAX_RETRIES=3
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
NEWS_INBOX_SUBDIR=Inbox
NEWS_AGENT_DB_PATH=news_agent.db
CORS_ALLOW_ORIGINS=https://ai-wiki-dashboard-minwoo.cheatmin.chatgpt.site,http://localhost:5173
# Generate a PBKDF2-SHA256 hash in a local terminal using an interactive prompt;
# copy only the printed hash to this ignored .env file or Render secret settings.
# python -c "import base64,hashlib,getpass,secrets; p=getpass.getpass(); s=secrets.token_urlsafe(16); d=hashlib.pbkdf2_hmac('sha256',p.encode(),s.encode(),600000); print(f'pbkdf2_sha256$600000${s}${base64.urlsafe_b64encode(d).decode()}')"
APP_PASSWORD_HASH=
# Generate a random session signing secret locally and store it outside Git.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
APP_ENV=development
# Keep local development on the filesystem. Set to r2 only on the API server.
DOCUMENT_STORAGE_BACKEND=local
# Local clone adapter root. Point this at ai-wiki-knowledge/knowledge.
KNOWLEDGE_ROOT=../ai-wiki-knowledge/knowledge
# Configure these public repository coordinates only for the GitHub backend.
KNOWLEDGE_STORE_BACKEND=filesystem
KNOWLEDGE_GITHUB_OWNER=shalsdn18
KNOWLEDGE_GITHUB_REPO=ai-wiki-knowledge
KNOWLEDGE_GITHUB_REF=main
KNOWLEDGE_GITHUB_ROOT=knowledge
KNOWLEDGE_GITHUB_REF_CHECK_SECONDS=30
KNOWLEDGE_GITHUB_STALE_MAX_SECONDS=900
# GitHub App credentials are not local .env settings. In Render, inject
# KNOWLEDGE_GITHUB_APP_ID, KNOWLEDGE_GITHUB_INSTALLATION_ID, and
# KNOWLEDGE_GITHUB_APP_PRIVATE_KEY as secrets after creating a read-only App.
# Set R2_ENDPOINT_URL directly, or provide R2_ACCOUNT_ID to derive the endpoint.
R2_ENDPOINT_URL=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Knowledge R2 is a separate, read-only adapter from the authenticated /documents
# CRUD store above. Keep all actual credentials in local ignored .env or Render secrets.
KNOWLEDGE_R2_ENDPOINT_URL=
KNOWLEDGE_R2_ACCOUNT_ID=
KNOWLEDGE_R2_BUCKET_NAME=
KNOWLEDGE_R2_ACCESS_KEY_ID=
KNOWLEDGE_R2_SECRET_ACCESS_KEY=
KNOWLEDGE_R2_REGION=auto
KNOWLEDGE_R2_PREFIX=knowledge
KNOWLEDGE_R2_REFRESH_SECONDS=30
KNOWLEDGE_R2_STALE_MAX_SECONDS=900
ENABLE_LOCAL_IMPORT=false
ENABLE_LOCAL_RAG=false
GIT_SYNC_ENABLED=false
GIT_SYNC_DEBOUNCE_SECONDS=30
# Set GEMINI_API_KEY only in the deployment provider's server secret settings.
