# Production or split-host deployment API origin (for example, the Render service URL).
# Leave unset during local/LAN development; Vite proxies /api to the local FastAPI server.
# VITE_API_BASE_URL=https://ai-wiki-api.onrender.com

# Optional local FastAPI target for the Vite development proxy.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
